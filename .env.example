# Dillow environment config — copy to .env.local and fill in for real data.
# With NOTHING set, the app uses the public SimplyRETS demo feed (randomized
# prices — good for UX, not for a real game).

# Which provider supplies properties: simplyrets | realtor16 | (add your own)
PROPERTY_PROVIDER=simplyrets

# ── realtor16 (RapidAPI) — real list prices + photos ─────────────────────────
# Requires a RapidAPI *subscription* to the realtor16 API (Basic/free is fine),
# not just a key: https://rapidapi.com/s.mahmoud97/api/realtor16
# REALTOR_16_API_KEY=your_rapidapi_key
# REALTOR16_LOCATION=Austin, TX
# REALTOR16_LIMIT=50

# ── SimplyRETS / any RESO Web API gateway ────────────────────────────────────
# Demo defaults are simplyrets / simplyrets. Replace with your real account or
# an MLS-backed RESO feed (via a licensed friend's IDX agreement) for true data.
# SIMPLYRETS_BASE_URL=https://api.simplyrets.com
# SIMPLYRETS_USER=your_key
# SIMPLYRETS_PASS=your_secret

# ── Placeholders for other providers you may wire into src/lib/providers ─────
# RENTCAST_API_KEY=
# RAPIDAPI_KEY=

# ── Admin ────────────────────────────────────────────────────────────────────
# Password for /admin (rotate the property of the day). Defaults to 8228 if unset.
# ADMIN_PASSWORD=8228
