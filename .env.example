# Dillow environment config — copy to .env.local and fill in.
#
#   cp .env.example .env.local
#
# NEVER commit .env.local, and never put a real value in this file — it is a
# template of NAMES only. .gitignore covers .env*, with this file excepted.
#
# With NOTHING set the app still runs: gameplay reads the committed snapshot in
# src/data/, game state lives in server memory, and the leaderboard and room
# features disable themselves gracefully. The provider settings below only
# matter for rebuilding that snapshot (/api/refresh).

# ── Provider selection ───────────────────────────────────────────────────────
# Which provider supplies properties: simplyrets | realtor16
# See src/lib/providers/index.ts to add your own.
PROPERTY_PROVIDER=simplyrets

# ── realtor16 (RapidAPI) — real list prices + photos ─────────────────────────
# Requires a RapidAPI *subscription* to the realtor16 API (the free Basic plan
# is enough), not just an account key:
#   https://rapidapi.com/s.mahmoud97/api/realtor16
# Read the README's "Data source and terms" section before you point this at
# anything you intend to publish.
REALTOR_16_RAPID_API_KEY=
# Comma-separated "City, ST" list used by /api/refresh. One request per city.
REALTOR16_LOCATIONS=
# Listings fetched per city (default 50).
REALTOR16_LIMIT=

# ── SimplyRETS / any RESO Web API gateway ────────────────────────────────────
# Defaults to the public demo account (simplyrets / simplyrets). Replace with a
# real account or an MLS-backed RESO feed (via a licensed IDX agreement) for
# true prices.
SIMPLYRETS_BASE_URL=
SIMPLYRETS_USER=
SIMPLYRETS_PASS=

# ── Upstash Redis — leaderboard, game state, galleries, rooms ────────────────
# Provisioned through the Vercel Marketplace (Upstash integration), which
# injects these automatically in deployed environments. For local dev, pull
# them with `vercel env pull` or copy them from the Upstash console.
# UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN are also accepted.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# ── Admin ────────────────────────────────────────────────────────────────────
# REQUIRED for /admin to work at all. There is no default: if this is unset,
# every /api/admin request is rejected. Use a long random string, not a PIN —
# the endpoint has no rate limiting and no lockout.
#   openssl rand -hex 24
ADMIN_PASSWORD=

# ── Manual data pipeline ─────────────────────────────────────────────────────
# Required in production as ?token=... on /api/refresh and /api/enrich. Those
# routes spend upstream API quota, so they refuse every request when this is
# unset. Local dev (NODE_ENV != production) does not need it.
REFRESH_TOKEN=

# ── Canonical site origin (optional) ─────────────────────────────────────────
# Used as metadataBase for OG/Twitter link previews. Defaults to
# https://dillow.homes. Set it on a fork or a preview deployment so previews
# point at your own origin rather than production's.
NEXT_PUBLIC_SITE_URL=

# ── Map (optional) ───────────────────────────────────────────────────────────
# Leave empty to use the keyless OpenStreetMap/Leaflet map. Set a browser key
# with the Maps Embed API enabled to switch to Google. This ships to the
# browser (NEXT_PUBLIC_*) — restrict it by HTTP referrer in Google Cloud.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
