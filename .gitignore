# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# keep the template, ignore real env files
!.env.example
.env*.local

# machine-local agent tooling
.claude/
.agents/

# maintainer scratch notes — not part of the project
.private/

# editors / OS cruft
.idea/
.vscode/
*.swp
Thumbs.db

# The real dataset (listing content + every future answer) lives in a private
# Vercel Blob store and is pulled at build time — see scripts/data.mjs. Only
# the fake sample dataset is committed.
/src/data/*
!/src/data/sample/
